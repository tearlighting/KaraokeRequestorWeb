{
  "name": "@yukari/api-server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/main.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/main.js",
    "start": "node dist/main.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
