{
  "id": "/user/",
  "name": "Yukari Karaoke",
  "short_name": "Yukari",
  "description": "Search songs and make karaoke requests in your Yukari room.",
  "start_url": "/user/",
  "scope": "/user/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#071f20",
  "theme_color": "#0f766e",
  "icons": [
    { "src": "icons/yukari-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/yukari-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/yukari-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
