{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "react": ["./node_modules/@types/react/index.d.ts"], "react/*": ["./node_modules/@types/react/*"], "@vue/reactivity": ["./node_modules/@vue/reactivity/dist/reactivity.d.ts"], "i18next": ["./node_modules/i18next/index.d.ts"] },
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
