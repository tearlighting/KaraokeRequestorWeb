# 設定ファイルはアップデートで更新しない
*.ini
foobar2000/
!foobar2000/foo_httpcontrol_data/karaokectrl/*
gitcmd/*

# 実行時に生成されるデータベース
cms/comment.db
prioritydb.db
request.db
cache/
updatenotice.db

# プレイヤー画面の永続化設定（TV依存のため環境ごと）
player_compensation.json

# 曲別音量オフセットの適用状態（実行時に生成）
volume_offset_state.json

# ゆかりすたー 4 NEBULA により生成されるフォルダー
list/

# Visual Studio cache/options directory
.vs/

# デバッグ用スクリプト（本番環境に含めない）
mypage_google_debug.php
.claude/settings.local.json

# getID3 解析キャッシュとファイルガードのロック（実行時に生成）
_getid3_cache/

# デバッグログ（実行時に生成）
ykrdebug.log

# Phase 1-3 local development artifacts and runtime data.
node_modules/
dist/
test-results/
playwright-report/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.log
**/*.ppk
**/*.pem
**/*.key
.env
.env.*
!.env.example
/.local/
/secrets/
**/bridge-token
/NUL

# Legacy runtime files remain private after relocation.
/legacy/php/NUL
/legacy/php/cache/
/legacy/php/_getid3_cache/
/legacy/php/list/
/legacy/php/foobar2000/
!/legacy/php/foobar2000/foo_httpcontrol_data/
